[["</body>","<script>/* 考察顺序切换按钮 + 原文库状态 */ (function(){ var Q=String.fromCharCode(34); function mode(){return window.__dxOrderMode?window.__dxOrderMode():'random'} function btn(m,txt,on){return '<button type='+Q+'button'+Q+' data-m='+Q+m+Q+' style='+Q+(on?'background:#53663d;color:#fff':'background:#f3f1e6;color:#5a5a4a')+';border:1px solid #cfc9b6;border-radius:999px;padding:5px 12px;font-size:13px;cursor:pointer'+Q+'>'+txt+'</button>'} function paint(){ var h=document.getElementById('plan-content');if(!h)return; var b=document.getElementById('dx-order-bar'); if(!b){b=document.createElement('div');b.id='dx-order-bar';b.style.cssText='display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:10px 12px;margin:0 0 10px;border:1px solid #d8d2bf;border-radius:12px;background:#fffdf7';h.insertBefore(b,h.firstChild)} var m=mode(); b.innerHTML='<b style='+Q+'font-size:13px;color:#53663d'+Q+'>考察顺序</b>'+btn('random','随机（现在这样）',m==='random')+btn('chapter','章节顺序',m==='chapter')+'<i style='+Q+'font-style:normal;font-size:12px;color:#7b7462'+Q+'>'+(m==='chapter'?'按科目 → 章 → 原顺序：第一、第二…':'按到期与薄弱优先穿插')+'</i>'; b.onclick=function(e){var t=e.target;if(!t||!t.getAttribute)return;var mm=t.getAttribute('data-m');if(!mm)return; window.__dxOrderMode(mm); var S=window.__PLAN_SESSION; if(S&&mm==='chapter'&&window.__dxSortKeys){var cur=S.keys[S.idx];S.keys=window.__dxSortKeys(S.keys);var j=S.keys.indexOf(cur);if(j>=0)S.idx=j} paint();if(typeof toast==='function')toast(mm==='chapter'?'已切换：按章节顺序考察':'已切换：随机穿插考察')}; } function libNote(){ var p=document.getElementById('dx-update-panel');if(!p)return; var P=window.DX_PDF_PAGES,ok=!!(P&&P['校体']&&P['校体'].length),d=document.getElementById('dx-lib-state'); var txt=ok?('原文库：已内置（校体'+P['校体'].length+'页 · 生理'+(P['生理']||[]).length+'页 · 训练'+(P['训练']||[]).length+'页）'):'原文库：本机缺失 —— 说明装的是旧安装包，需安装最新 APK'; if(!d){d=document.createElement('div');d.id='dx-lib-state';d.style.cssText='margin:8px 0 0;font-size:13px';p.appendChild(d)} d.textContent=txt;d.style.color=ok?'#4f6a35':'#a2543c'; } var RP=window.renderPlan; if(RP)window.renderPlan=function(){var r=RP.apply(this,arguments);try{paint()}catch(e){}return r}; setInterval(function(){libNote();if(!document.getElementById('dx-order-bar')){try{paint()}catch(e){}}},1500);setTimeout(function(){try{paint()}catch(e){}libNote()},300); })(); </script></body>"]]