[["</body>", "<script> (function(){ var R=window.DXSRC; function closeM(){var m=document.getElementById('dx-pdf-modal');if(m&&m.parentNode)m.parentNode.removeChild(m)} function show(o){var arr=(window.DX_PDF_PAGES||{})[o.sub]||[],t=arr[o.page-1];if(!t){alert('本机没有内置这本原文的分页文字，请安装最新版安装包后再试。');return} var Q=String.fromCharCode(34),A=function(s){return ' '+s};var m=document.createElement('div');m.id='dx-pdf-modal';m.style.cssText='position:fixed;inset:0;background:rgba(20,28,22,.55);z-index:9000;display:flex;align-items:center;justify-content:center;padding:12px';var card='<div'+A('style='+Q+'background:#fff;width:min(760px,96vw);max-height:88vh;border-radius:16px;display:flex;flex-direction:column;overflow:hidden'+Q)+'>'+'<div'+A('style='+Q+'padding:14px 16px;border-bottom:1px solid #e3e8dc;display:flex;justify-content:space-between;align-items:center;gap:10px'+Q)+'>'+'<b'+A('style='+Q+'font-size:15px'+Q)+'>'+R.esc(R.TXT[o.sub])+' · 第 '+o.page+' 页</b>'+'<button'+A('type='+Q+'button'+Q)+A('style='+Q+'border:1px solid #cfd8c6;background:#f4f6ef;border-radius:9px;padding:6px 12px'+Q)+'>关闭</button></div>'+'<div'+A('style='+Q+'padding:14px 16px;overflow:auto;white-space:pre-wrap;line-height:1.75;font-size:14px'+Q)+'>'+R.mark(t,o.q)+'</div>'+'<div'+A('style='+Q+'padding:10px 16px;border-top:1px solid #e3e8dc;font-size:12px;color:#6b7768'+Q)+'>原文照录，仅供对照核验；标黄处是本题题干在原文里的位置。</div></div>';m.innerHTML=card;m.onclick=function(e){if(e.target===m)closeM()};m.querySelector('button').onclick=closeM;document.body.appendChild(m)} function ensure(){var card=document.getElementById('study-card');if(!card)return;var box=card.querySelector('.answer-box');if(!box)return;if(card.querySelector('.dx-src-wrap'))return;var o=R.info();if(!o)return;var wrap=document.createElement('div');wrap.className='dx-src-wrap';wrap.style.cssText='display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 2px';var b=document.createElement('button');b.type='button';b.style.cssText='border:1px solid #cfd8c6;background:#f4f